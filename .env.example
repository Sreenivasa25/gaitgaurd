# Hardware
DEVICE_TYPE=raspberry_pi_5
POSE_BACKEND=mediapipe

# Baseline & Drift
BASELINE_WINDOW_HOURS=4
DRIFT_WINDOW_MINUTES=10
FATIGUE_RISK_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/gaitguard.log

# GPU (for development)
ENABLE_GPU=false
CUDA_DEVICE_ID=0

# Experiment
EXPERIMENT_ID=baseline_trial_001
SUBJECT_ID=worker_001
